{
    "name": "@evva/nest-xs3-api-client",
    "version": "3.0.14",
    "description": "Client implementation for the Xesar 3 MQTT api interface.",
    "private": false,
    "author": "EVVA Sicherheitstechnologie GmbH",
    "license": "EVVA Software License",
    "scripts": {
        "build": "npx nest build -p tsconfig.build.json",
        "lint": "npx eslint src",
        "lint:fix": "npm run lint -- --fix",
        "prettier": "npx prettier \"**/*.{js,ts,jsx,tsx,cjs,cts,mjs,mts,vue,astro,css,scss,json}\" --check",
        "prettier:fix": "npm run prettier -- --write",
        "format": "npm run prettier:fix && npm run lint:fix",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:cov": "vitest run --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --runInBand",
        "test:e2e": "vitest run --config ./test/vitest-e2e.json",
        "prepack": "npx nest build"
    },
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/evva-sfw/nest-xs3-api-client.git"
    },
    "bugs": {
        "url": "https://github.com/evva-sfw/nest-xs3-api-client/issues"
    },
    "keywords": [
        "nestjs",
        "xs3-api",
        "client"
    ],
    "dependencies": {
        "@evva/nest-mqtt": "^2.1.0",
        "@nestjs/event-emitter": "^12.0.0",
        "@typescript-eslint/parser": "^8.70.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.3",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.6",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.1",
        "prettier-eslint": "^17.1.2",
        "reflect-metadata": "^0.2.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
