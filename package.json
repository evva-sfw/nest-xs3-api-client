{
    "name": "@evva/nest-xs3-api-client",
    "version": "4.1.0",
    "description": "Client implementation for the Xesar 3 MQTT api interface.",
    "private": false,
    "author": "EVVA Sicherheitstechnologie GmbH",
    "license": "EVVA Software License",
    "scripts": {
        "build": "npx nest build -p tsconfig.build.json",
        "lint": "oxlint src/ test/",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:cov": "vitest run --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --runInBand",
        "test:e2e": "vitest run --config ./test/vitest-e2e.json",
        "audit:sbom": "npm sbom --omit=dev --omit=optional --package-lock-only=true --sbom-format spdx --sbom-type application > $(basename $npm_package_name-sbom.spdx)",
        "prepack": "npx nest build"
    },
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/evva-sfw/nest-xs3-api-client.git"
    },
    "bugs": {
        "url": "https://github.com/evva-sfw/nest-xs3-api-client/issues"
    },
    "keywords": [
        "nestjs",
        "xs3-api",
        "client"
    ],
    "dependencies": {
        "@evva/nest-mqtt": "^2.1.0",
        "@nestjs/event-emitter": "^12.0.0",
        "@typescript-eslint/parser": "^8.70.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "oxlint": "^1.58.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "reflect-metadata": "^0.2.2",
        "typescript": "^6.0.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2"
    }
}
